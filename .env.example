# IssueSight Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=issuesight
# Full connection URL (for services)
DATABASE_URL=postgres://postgres:your-secure-password-here@localhost:5435/issuesight?sslmode=disable

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# GitHub OAuth (for user authentication)
# Create at: https://github.com/settings/developers
# =============================================================================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub API Token (for fetching issues)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-personal-access-token

# =============================================================================
# Google OAuth (optional)
# Create at: https://console.cloud.google.com/apis/credentials
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# LLM Configuration
# =============================================================================
# Provider: openai, anthropic, gemini, ollama, cohere
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-5
# For Ollama or custom endpoints:
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# =============================================================================
# JWT Authentication
# =============================================================================
# IMPORTANT: Generate a strong secret for production!
# Example: openssl rand -base64 32
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=24h

# =============================================================================
# Server Configuration
# =============================================================================
# Environment: development or production
ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text

# Service URLs (for production)
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# CORS allowed origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:3000

# Collector service URL (gateway calls this; use http://collector:8081 in Docker)
COLLECTOR_URL=http://localhost:8081

# Rate limit (per IP): requests per window. Set to 0 to disable (e.g. for testing).
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m

# Quota (per user, per day): issue submissions. Set to 0 for unlimited (e.g. for testing).
QUOTA_DAILY_LIMIT=10

# =============================================================================
# Service Ports (optional, defaults shown)
# =============================================================================
# GATEWAY_PORT=8080
# COLLECTOR_PORT=8081
# AI_PROCESSOR_PORT=8082
